# Phase 1 wallet smoke (Ready / Wallet API spike)
# Use matching RPC/network pairs. Direct privacy transactions require a
# proof-aware Starknet RPC >= 0.10; Cartridge's 0.9 endpoint is incompatible.
# No deployer, resolver, or other server secret may use a VITE_ prefix.
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
VITE_STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
VITE_STARKNET_NETWORK=sepolia
# Optional override for Ready-native shield/balance/transfer. Sepolia defaults
# to Circle's current native test USDC; this does not change deployed escrows.
VITE_READY_USDC_ADDRESS=
STARKNET_NETWORK=sepolia
# Optional engineer spike only — not started by `pnpm dev` (use pnpm dev:wallet-smoke).
# Direct Privacy SDK route used for Sepolia development. These are public
# infrastructure URLs consumed only by the local Vite reverse proxy.
PRIVACY_PROVER_UPSTREAM=https://transaction-prover.alpha-sepolia.sw-dev.io
PRIVACY_DISCOVERY_UPSTREAM=https://discovery-service.alpha-sepolia.sw-dev.io
# Local test-only outer proof submitter. These remain server-side in Vite and
# must never be renamed with a VITE_ prefix.
STARKNET_DEPLOYER_ADDRESS=
STARKNET_DEPLOYER_PRIVATE_KEY=
# Optional override only when deploying a newly declared Wotta escrow class.
# The direct-route deploy script normally reuses the verified class already in
# deployments/sepolia.json, and writes the deployed address back to that file.
WOTTA_DIRECT_ESCROW_CLASS_HASH=
VITE_HELPER_ADDRESS=
VITE_TRANSFER_RECIPIENT=
VITE_SMOKE_AMOUNT=1000000
VITE_WOTTA_API_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
VITE_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org

# Backend (Phase 2)
NODE_ENV=development
PORT=8787
API_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional dedicated relayer. Local Sepolia falls back to the deployer account
# when these are empty; production should use a separately funded account.
STARKNET_RELAYER_ADDRESS=
# Raw key for the local Sepolia relayer. Keep server-side; never use VITE_.
STARKNET_RELAYER_PRIVATE_KEY=
STARKNET_RELAYER_KEY_OR_KEYSTORE=
RESOLVER_SIGNING_KEY=
IDENTITY_LOOKUP_KEY=
PENDING_DELIVERY_PRIVATE_KEY=
CIRCLE_IRIS_BASE_URL=https://iris-api-sandbox.circle.com
# Comma-separated routes admitted only after retaining their route-specific
# live burn → Iris → Starknet funded evidence. Example after Base passes: base
CCTP_ADMITTED_ROUTES=
RESEND_API_KEY=

# Route RPCs (Phase 2+)
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
SOLANA_RPC_URL=
STELLAR_HORIZON_URL=

# Public web (Phase 3)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STARKNET_NETWORK=sepolia
NEXT_PUBLIC_DEPLOYMENT_MANIFEST_PATH=/manifests/sepolia.json
