{
  "name": "@wotta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/server.ts",
    "dev:indexer": "node --env-file=../../.env --import tsx/esm --watch src/indexer.ts",
    "dev:relayer": "node --env-file=../../.env --import tsx/esm --watch src/relayer.ts",
    "build": "pnpm typecheck && pnpm openapi:generate",
    "start": "node --import tsx/esm src/server.ts",
    "start:indexer": "node --import tsx/esm src/indexer.ts",
    "start:relayer": "node --import tsx/esm src/relayer.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx src/openapi/write.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@supabase/supabase-js": "2.115.0",
    "@wotta/crypto": "workspace:*",
    "@wotta/adapters": "workspace:*",
    "@wotta/shared": "workspace:*",
    "fastify": "5.12.1",
    "jose": "5.10.0",
    "pino": "9.6.0",
    "starknet": "10.5.0",
    "tsx": "4.19.3",
    "tweetnacl": "1.0.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": { "@types/node": "24.0.15", "typescript": "5.8.3" }
}
